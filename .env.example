# x402 Payment Protocol
X402_FACILITATOR_URL=https://x402.org/facilitator
PROVIDER_EVM_ADDRESS=0x...
BUYER_EVM_PRIVATE_KEY=0x...

# Research Engine
RESEARCH_ENGINE_URL=http://localhost:8100

# LLM Provider (GEIA / OpenAI-compatible)
GEIA_API_KEY=
GEIA_API_BASE=https://api.saia.ai/v1

# Search
TAVILY_API_KEY=

# Hugging Face (optional — avoids rate-limit warnings for sentence-transformers)
HF_TOKEN=

# Logging
LOG_LEVEL=info

# Mock mode (bypass real engine + LLM calls)
MOCK_MODE=false

# LLM Models
BUYER_LLM_MODEL=vertex_ai/gemini-2.5-pro
PROVIDER_LLM_MODEL=vertex_ai/gemini-2.5-pro
PROVIDER_LLM_MODEL_FAST=vertex_ai/gemini-2.5-flash
