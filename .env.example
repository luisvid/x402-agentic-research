# x402 Payment Protocol
X402_FACILITATOR_URL=https://x402.org/facilitator
PROVIDER_EVM_ADDRESS=0x...
BUYER_EVM_PRIVATE_KEY=0x...

# Research Engine
RESEARCH_ENGINE_URL=http://localhost:8100

# LLM Provider — selects backend: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=           # required only if LLM_PROVIDER=anthropic

# Search
TAVILY_API_KEY=

# Hugging Face (optional — avoids rate-limit warnings for sentence-transformers)
HF_TOKEN=

# Logging
LOG_LEVEL=info

# Mock mode (bypass real engine + LLM calls)
MOCK_MODE=false

# LLM Models
# Buyer agent (TypeScript)
BUYER_LLM_MODEL=gpt-4o
BUYER_LLM_MODEL_FAST=gpt-4o-mini
# Research engine (Python)
PROVIDER_LLM_MODEL=gpt-4o
PROVIDER_LLM_MODEL_FAST=gpt-4o-mini

# LangSmith tracing (optional — enables LLM call observability via langsmith.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=x402-research-engine
